# ============================================================
#  .env.example — copy to .env and fill in real values
#  This file contains NO real secrets. It only documents the
#  environment variables the application expects.
# ============================================================

# Database — PostgreSQL required (Supabase or local)
# Direct connection:  postgresql://user:password@host:5432/dbname
# Supabase pooler:    postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth — set to enable protection on destructive endpoints
# (DELETE /api/data, POST /api/settings, POST /api/pic, etc.)
# If unset, destructive endpoints are open in dev mode but
# fail-closed (403) in production.
# ADMIN_TOKEN=your-secret-token-here

# Optional — Google Drive import (https://console.cloud.google.com/)
# GOOGLE_DRIVE_API_KEY=

# Optional — inventory data directory (defaults to ./data/inventory)
# INVENTORY_DATA_DIR=
