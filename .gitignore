# ============================================================
# Inventory Control — sensitive data (DO NOT PUSH TO GITHUB)
# ============================================================
# Database file (contains your inventory data — 144MB+)
/db/*.db
/db/*.db-journal
/db/*.db-wal
/db/*.db-shm

# Excel source files (your company data — DO NOT PUSH)
/data/inventory/*.xlsx
/data/inventory/*.xls
/data/inventory/*.csv
/data/inventory/~$*

# Upload folder (user uploads)
/upload/

# Any .db files anywhere
*.db
*.db-journaltool-results/
tool-results/
*.tmp
data/inventory/*.csv
data/inventory/*.tmp
.zscripts/dev.pid
