// ============================================================
//  Inventory Control Intelligence Platform — Prisma Schema
//  PostgreSQL (Supabase) backend
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
//  Source file tracking (idempotent ingest by file hash)
// ------------------------------------------------------------
model SourceFile {
  id          Int      @id @default(autoincrement())
  fileName    String   @unique
  filePath    String
  monthLabel  String   // "Juli 2026" (parsed from filename)
  monthKey    String   // "2026-07" sortable
  fileHash    String   @unique
  rowCount    Int      @default(0)
  dqStatus    String   @default("OK") // OK | WARNING | ERROR
  dqErrorCount   Int   @default(0)
  dqWarningCount Int   @default(0)
  importedAt  DateTime @default(now())
  records     InventoryRecord[]
  weeks       Week[]
  dqIssues    DQIssue[]
}

// ------------------------------------------------------------
//  Week (period within a month). CUMULATIVE (user confirmed):
//  WEEK 1 = day 1-7, WEEK 2 = day 1-14, WEEK 3 = day 1-21, WEEK 4 = day 1-25
//  Each week INCLUDES all previous weeks. Comparison must be same-week
//  across months (W4 Juli vs W4 Juni, NOT W4 vs W2).
// ------------------------------------------------------------
model Week {
  id            Int      @id @default(autoincrement())
  sourceFileId  Int
  sourceFile    SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  weekLabel     String   // "WEEK 1"
  weekKey       String   // "2026-07-W1" sortable unique
  monthKey      String   // "2026-07"
  periodStart   Int      // 1
  periodEnd     Int      // 7
  records       InventoryRecord[]

  @@unique([sourceFileId, weekLabel])
  @@index([monthKey])
}

// ------------------------------------------------------------
//  Outlet (19 outlets, supports XXXX.NNNN and B.XXXX.NNNN formats)
// ------------------------------------------------------------
model Outlet {
  id        Int      @id @default(autoincrement())
  code      String   @unique // "1030.BDGSET" or "B.1001.MLGPAR"
  name      String   // "BDGSET"
  outletCode String  // numeric part "1030" or "1001"
  area      String   // "JAWA BARAT 1"
  records   InventoryRecord[]
}

// ------------------------------------------------------------
//  Item (raw material)
// ------------------------------------------------------------
model Item {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  satuan      String?  // UOM (per item, no cross-conversion)
  category    String?  // BAHAN | PACKAGING (auto-detected if possible)
  records     InventoryRecord[]
}

// ------------------------------------------------------------
//  Main inventory record (one row per outlet × item × week × account)
//  Natural key: (outletId, itemId, weekId, akunPenyesuaian)
// ------------------------------------------------------------
model InventoryRecord {
  id                  Int      @id @default(autoincrement())
  sourceFileId        Int
  sourceFile          SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  weekId              Int
  week                Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  outletId            Int
  outlet              Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  itemId              Int
  item                Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // Raw columns from Excel (sign convention: BOM/COM/WASTE/SUSUT/TRIAL = negative)
  akunPenyesuaian     String?  // "COM DEVIASI - RESTO"
  status              String?  // "DEVIASI"
  satuan              String?  // denormalized for traceability
  qtyBom              Float?
  qtyCom              Float?
  qtyDeviasi          Float?
  qtyWaste            Float?
  qtySusut            Float?
  qtyTrial            Float?
  qtyLossSurplus      Float?
  nominalDeviasi      Float?
  nominalWaste        Float?
  nominalSusut        Float?
  nominalTrial        Float?
  nominalLossSurplus  Float?
  nominalSales        Float?   // from PENJUALAN column (outlet-level, denormalized)
  avgPrice            Float?   // derived: |nominalDeviasi / qtyDeviasi| if applicable
  tolerancePct        Float?   // null if "BELUM ADA TOLERANSI"
  toleranceRaw        String?  // raw value for audit

  // Pre-computed ratios from Excel (kept for audit; engine recomputes)
  pctWasteSusut       Float?
  pctQtyDeviasiToBom  Float?
  pctQtyWasteToBom    Float?
  pctQtySusutToBom    Float?
  pctQtyTrialToBom    Float?
  pctQtyLossToBom     Float?

  // Engine-derived (computed at transform layer)
  direction           String?  // LOSS | SURPLUS | NEUTRAL
  residualQty         Float?   // qtyDeviasi - (qtyWaste + qtySusut + qtyTrial)
  residualNominal     Float?
  residualRatio       Float?   // residualQty / qtyDeviasi
  absQtyDeviasi       Float?
  absNominalDeviasi   Float?
  absQtyLossSurplus   Float?
  absNominalLossSurplus Float?

  area                String   // denormalized for fast filtering
  bulan               String   // "191.JULI 26"
  bulan2              String?  // "19.JULI"
  weekLabel           String   // "WEEK 1"
  monthLabel          String

  createdAt           DateTime @default(now())

  @@unique([weekId, outletId, itemId, akunPenyesuaian])
  @@index([outletId, weekId])
  @@index([itemId, weekId])
  @@index([area, weekId])
  @@index([monthLabel, weekLabel])
  @@index([direction])
  @@index([outletId, itemId])
  @@index([area, monthLabel, weekLabel])
  @@index([monthLabel, weekLabel, outletId])
  // OPTIMIZE-ENGINE: speed up cascade delete when a SourceFile is removed
  // (PostgreSQL FK columns do NOT get an automatic index — without this,
  // deleting a SourceFile triggers a full-table scan on InventoryRecord).
  @@index([sourceFileId])
}

// ------------------------------------------------------------
//  Data Quality issues
// ------------------------------------------------------------
model DQIssue {
  id          Int      @id @default(autoincrement())
  sourceFileId Int
  sourceFile  SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  weekId      Int?
  outletId    Int?
  itemId      Int?
  severity    String   // ERROR | WARNING | INFO
  code        String   // MISSING_BOM | DUPLICATE | INVALID_NUMBER | TOLERANCE_NOT_SET | ...
  message     String
  rawValue    String?
  rowNumber   Int?
  sheetName   String?  // P1-9 fix: which Excel sheet the issue came from
  createdAt   DateTime @default(now())

  @@index([sourceFileId])
  @@index([code, severity])
}

// ------------------------------------------------------------
//  Audit log (every ingest/calc/refresh)
// ------------------------------------------------------------
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // INGEST | CALC | RULE_EVAL | NARRATIVE | REFRESH | DRILL
  detail    String
  duration  Int?     // ms
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
//  Materialized aggregation cache (pre-computed for performance)
// ------------------------------------------------------------
model AggregationCache {
  id        Int      @id @default(autoincrement())
  cacheKey  String   @unique // "summary|2026-07|WEEK 1|ALL|ALL"
  payload   String   // JSON
  computedAt DateTime @default(now())

  // PERF-OPT: index on computedAt — used by TTL cleanup queries
  // (getCached filters by computedAt > now() - TTL). Without this index,
  // every cache read does a full-table scan on AggregationCache (small
  // today but grows linearly with ingest activity).
  @@index([computedAt])
}

// ------------------------------------------------------------
//  Settings — user-configurable business standards & thresholds
//  Stored as key-value pairs. Engine reads from here, falls back
//  to hardcoded defaults in src/config/thresholds.ts if not set.
// ------------------------------------------------------------
model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   // stored as string, parsed by consumer
  category    String   // TOLERANCE | GROWTH | PRIORITY | BENCHMARK | GENERAL
  label       String   // human-readable label
  description String?
  dataType    String   // number | percent | boolean | text
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // who changed it (for audit)
}

// ------------------------------------------------------------
//  Outlet PIC (Person in Charge) — outlet-to-staff mapping
// ------------------------------------------------------------
model OutletPIC {
  id         Int      @id @default(autoincrement())
  outletCode String   @unique
  pic        String
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------
//  File Chunk — temporary storage for chunked uploads
//  Vercel serverless /tmp doesn't persist between invocations,
//  so chunks are stored in DB and reassembled on last chunk.
//  Auto-cleaned after processing (DELETE WHERE fileHash).
// ------------------------------------------------------------
model FileChunk {
  id           Int      @id @default(autoincrement())
  fileHash     String
  chunkIndex   Int
  totalChunks  Int      @default(0) // P2-11 fix: track total for validation
  data         Bytes
  createdAt    DateTime @default(now())

  @@unique([fileHash, chunkIndex])
  @@index([fileHash])
}
