// ============================================================
//  Inventory Control Intelligence Platform — Prisma Schema
//  PostgreSQL (Supabase) backend
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
//  Source file tracking (idempotent ingest by file hash)
// ------------------------------------------------------------
model SourceFile {
  id          Int      @id @default(autoincrement())
  fileName    String   @unique
  filePath    String
  monthLabel  String   // "Juli 2026" (parsed from filename)
  monthKey    String   // "2026-07" sortable
  fileHash    String   @unique
  rowCount    Int      @default(0)
  dqStatus    String   @default("OK") // OK | WARNING | ERROR
  dqErrorCount   Int   @default(0)
  dqWarningCount Int   @default(0)
  importedAt  DateTime @default(now())
  records     InventoryRecord[]
  weeks       Week[]
  dqIssues    DQIssue[]
  outletPeriodSales OutletPeriodSales[]
}

// ------------------------------------------------------------
//  Week (period within a month). CUMULATIVE (user confirmed):
//  WEEK 1 = day 1-7, WEEK 2 = day 1-14, WEEK 3 = day 1-21, WEEK 4 = day 1-25
//  Each week INCLUDES all previous weeks. Comparison must be same-week
//  across months (W4 Juli vs W4 Juni, NOT W4 vs W2).
// ------------------------------------------------------------
model Week {
  id            Int      @id @default(autoincrement())
  sourceFileId  Int
  sourceFile    SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  weekLabel     String   // "WEEK 1"
  weekKey       String   // "2026-07-W1" sortable (NOT unique — see @@unique below)
  monthKey      String   // "2026-07"
  periodStart   Int      // 1
  periodEnd     Int      // 7
  records       InventoryRecord[]

  // (sourceFileId, weekLabel) — same-file re-import upsert anchor.
  @@unique([sourceFileId, weekLabel])
  // FIX (AUDIT-BUG-1): a (monthKey, weekLabel) pair must map to AT MOST ONE
  // Week row. Previously weekKey's "unique" existed only in a comment, so a
  // re-import of the same month under a DIFFERENT fileName created a second
  // SourceFile + second Week for the same period → every period-filtered
  // aggregate DOUBLE-COUNTED. This DB-level constraint makes the duplicate
  // impossible (ingest-process now purges the old cross-file week BEFORE
  // the upsert; scripts/fix-duplicate-weeks.ts cleans existing dupes).
  @@unique([monthKey, weekLabel])
  @@index([monthKey])
}

// ------------------------------------------------------------
//  Outlet (19 outlets, supports XXXX.NNNN and B.XXXX.NNNN formats)
// ------------------------------------------------------------
model Outlet {
  id        Int      @id @default(autoincrement())
  code      String   @unique // "1030.BDGSET" or "B.1001.MLGPAR"
  name      String   // "BDGSET"
  outletCode String  // numeric part "1030" or "1001"
  area      String   // "JAWA BARAT 1"
  records   InventoryRecord[]
  outletPeriodSales OutletPeriodSales[]
}

// ------------------------------------------------------------
//  Item (raw material)
// ------------------------------------------------------------
model Item {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  satuan      String?  // UOM (per item, no cross-conversion)
  category    String?  // BAHAN | PACKAGING (auto-detected if possible)
  records     InventoryRecord[]
}

// ------------------------------------------------------------
//  Main inventory record (one row per outlet × item × week × account)
//  Natural key: (outletId, itemId, weekId, akunPenyesuaian)
// ------------------------------------------------------------
model InventoryRecord {
  id                  Int      @id @default(autoincrement())
  sourceFileId        Int
  sourceFile          SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  weekId              Int
  week                Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  outletId            Int
  outlet              Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  itemId              Int
  item                Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // Raw columns from Excel (sign convention: BOM/COM/WASTE/SUSUT/TRIAL = negative)
  akunPenyesuaian     String?  // "COM DEVIASI - RESTO"
  status              String?  // "DEVIASI"
  satuan              String?  // denormalized for traceability
  qtyBom              Float?
  qtyCom              Float?
  qtyDeviasi          Float?
  qtyWaste            Float?
  qtySusut            Float?
  qtyTrial            Float?
  qtyLossSurplus      Float?
  nominalDeviasi      Float?
  nominalWaste        Float?
  nominalSusut        Float?
  nominalTrial        Float?
  nominalLossSurplus  Float?
  nominalSales        Float?   // from PENJUALAN column (outlet-level, denormalized)
  avgPrice            Float?   // derived: |nominalDeviasi / qtyDeviasi| if applicable
  tolerancePct        Float?   // null if "BELUM ADA TOLERANSI"
  toleranceRaw        String?  // raw value for audit

  // Pre-computed ratios from Excel (kept for audit; engine recomputes)
  pctWasteSusut       Float?
  pctQtyDeviasiToBom  Float?
  pctQtyWasteToBom    Float?
  pctQtySusutToBom    Float?
  pctQtyTrialToBom    Float?
  pctQtyLossToBom     Float?

  // Engine-derived (computed at transform layer)
  direction           String?  // LOSS | SURPLUS | NEUTRAL
  residualQty         Float?   // qtyDeviasi - (qtyWaste + qtySusut + qtyTrial)
  residualNominal     Float?
  residualRatio       Float?   // residualQty / qtyDeviasi
  absQtyDeviasi       Float?
  absNominalDeviasi   Float?
  absQtyLossSurplus   Float?
  absNominalLossSurplus Float?

  area                String   // denormalized for fast filtering
  bulan               String   // "191.JULI 26"
  bulan2              String?  // "19.JULI"
  weekLabel           String   // "WEEK 1"
  monthLabel          String

  createdAt           DateTime @default(now())

  // AUDIT-BUG-3: in PostgreSQL NULL ≠ NULL in unique indexes, so this
  // constraint does NOT stop duplicate rows when akunPenyesuaian IS NULL
  // (createMany skipDuplicates lets both through → double-counted
  // aggregates). A NULL-safe EXPRESSION index can't be expressed in
  // Prisma, so it is created by scripts/fix-null-akun-duplicates.ts
  // (also dedups existing rows first):
  //   CREATE UNIQUE INDEX "InventoryRecord_nullsafe_akun"
  //   ON "InventoryRecord" ("weekId","outletId","itemId",
  //      COALESCE("akunPenyesuaian", ''))
  // ON CONFLICT DO NOTHING (skipDuplicates) honors it. Keep this
  // @@unique too — it covers the akun NOT NULL case and documents the
  // natural key for Prisma Client's upsert/where types.
  @@unique([weekId, outletId, itemId, akunPenyesuaian])
  @@index([outletId, weekId])
  @@index([itemId, weekId])
  @@index([area, weekId])
  @@index([monthLabel, weekLabel])
  // P3-HYG-2: single-column index [direction] REMOVED — dead weight.
  // No query filters on InventoryRecord.direction (every "direction" in
  // src/lib/queries is a SELECTed computed value from SUMs/CTEs;
  // /api/migrate-direction only SETs it). A 3-value low-cardinality
  // B-tree is never chosen by the planner, so the index only added write
  // amplification — every ingest (~54K rows/month) + every bulk import
  // maintained a dead B-tree. Takes effect on the next `bun run db:push`.
  @@index([outletId, itemId])
  @@index([area, monthLabel, weekLabel])
  @@index([monthLabel, weekLabel, outletId])
  // PERF-FASE1-DB01: Composite index for prev-period LATERAL JOIN in
  // evaluateRulesSql + queryVarianceAnalysis. These queries filter by
  // (outletId, itemId, akunPenyesuaian, monthLabel, weekLabel) to find
  // the previous-period record. Without this index, PostgreSQL does a
  // full-scan hash join over ~13.5K rows × 35K = 472M row examines.
  // Expected: -4 to -6 seconds on /api/analysis cold cache.
  @@index([outletId, itemId, akunPenyesuaian, monthLabel, weekLabel])
  // PERF-DB: Composite index for heatmap cells query (heatmap.ts Step 3)
  // which filters by monthLabel + weekLabel + JOIN on itemId via Item.name
  // IN (...) list of ~20–100 items. Without this index, PG uses
  // (monthLabel, weekLabel) and scans all ~13.5K rows for the period,
  // then hash-joins with Item. With this index, PG can do an index lookup
  // per itemId in the IN list — significantly faster when the IN list is
  // small. Also accelerates historical.ts GROUP BY (outletId, itemId,
  // monthLabel, weekLabel) — the index provides a partial pre-sort that
  // reduces the sort cost for the outer GROUP BY pass.
  @@index([monthLabel, weekLabel, itemId])
  // OPTIMIZE-ENGINE: speed up cascade delete when a SourceFile is removed
  // (PostgreSQL FK columns do NOT get an automatic index — without this,
  // deleting a SourceFile triggers a full-table scan on InventoryRecord).
  @@index([sourceFileId])
  // PERF-FASE5-DB02: Covering index for flip-ranking query (SUM qtyDeviasi
  // GROUP BY monthLabel, weekLabel, itemName). Query filters by weekLabel
  // + itemName exact match, then GROUP BY (month, week, item). This index
  // pre-sorts by (week, item, month) so the GROUP BY is nearly free.
  @@index([weekLabel, itemId, monthLabel, qtyDeviasi])
  // PERF-FIX: Index 1 + Index 3 dropped — redundant with existing indexes.
  // Index 1 [mL,wL,iId,oId,nLS] had 3-col prefix identical to existing [mL,wL,iId].
  // Index 3 [mL,wL,nLS,oId,qD] had 2-col prefix identical to existing [mL,wL].
  // Both caused query planner confusion (stale stats picked wrong index).
  // ANALYZE has been run on Supabase to update stats.
  // PERF-HIST-AGG (FX-PERF): Covering index for queryHistoricalStatsMultiMetric.
  // The historical Z-Score baseline scans 7+ months × WEEK N records (~280K rows
  // for 8 months of data) and groups by (outletId, itemId, monthLabel, weekLabel),
  // aggregating 5 metrics (qtyBom/qtyDeviasi/qtyWaste/qtySusut/qtyTrial).
  // Before this index: 8s with parallel index scan + incremental sort + disk
  // spill on HashAggregate. After: 1.6s with Index Only Scan (Heap Fetches=0).
  // Index columns (weekLabel, monthLabel, outletId, itemId) match the WHERE +
  // GROUP BY order; INCLUDE columns enable index-only scan (no heap fetch).
  // This index is also used by /api/pareto's 5 queryParetoHistorical calls.
  @@index([weekLabel, monthLabel, outletId, itemId])

  // ⚠️ AUDIT-DB-PUSH-2 — COVERING (INCLUDE) INDEX WARNING ⚠️
  // The three indexes above with "covering" comments exist in the DB with
  // INCLUDE columns (index-only scans — e.g. histAgg 8s → 1.6s) created via
  // raw SQL. Prisma CANNOT model INCLUDE, so on every `prisma db push` /
  // `migrate` it will DROP the INCLUDE versions and CREATE these plain
  // shadows instead. After ANY db push/migrate, run:
  //     bun run db:recreate-covering-indexes
  // (scripts/recreate-covering-indexes.ts — idempotent) to restore the
  // INCLUDE versions (then optionally drop the plain duplicates it lists).
}

// ------------------------------------------------------------
//  OutletPeriodSales — pre-computed MODE(nominalSales) per outlet+period
//  (DB-06). Replaces the duplicated sales_counts → ranked_sales →
//  sales_mode CTE pipeline in 10+ query call sites. Populated at
//  ingest time (src/lib/ingestion.ts STEP 3.5) and backfilled from
//  existing InventoryRecord data via scripts/backfill-outlet-period-sales.ts.
//  Cascade-deleted with the parent SourceFile (latest wins on conflict).
// ------------------------------------------------------------
model OutletPeriodSales {
  id           Int      @id @default(autoincrement())
  outletId     Int
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  monthLabel   String   // "Juli 2026"
  weekLabel    String   // "WEEK 1"
  // MODE(nominalSales) — most frequent nominalSales value for this
  // (outletId, monthLabel, weekLabel) triple, with smaller-value-wins
  // tie-break (matches computeSalesModePerOutlet in src/lib/metrics/sales.ts
  // and the inline sales_mode CTE it replaces).
  salesMode    Float
  sourceFileId Int
  sourceFile   SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  computedAt   DateTime @default(now())

  @@unique([outletId, monthLabel, weekLabel])
  @@index([monthLabel, weekLabel])
  @@index([monthLabel, weekLabel, outletId])
  @@index([sourceFileId])
}

// ------------------------------------------------------------
//  Data Quality issues
// ------------------------------------------------------------
model DQIssue {
  id          Int      @id @default(autoincrement())
  sourceFileId Int
  sourceFile  SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  weekId      Int?
  outletId    Int?
  itemId      Int?
  severity    String   // ERROR | WARNING | INFO
  code        String   // MISSING_BOM | DUPLICATE | INVALID_NUMBER | TOLERANCE_NOT_SET | ...
  message     String
  rawValue    String?
  rowNumber   Int?
  sheetName   String?  // P1-9 fix: which Excel sheet the issue came from
  createdAt   DateTime @default(now())

  @@index([sourceFileId])
  @@index([code, severity])
}

// ------------------------------------------------------------
//  Materialized aggregation cache (pre-computed for performance)
// ------------------------------------------------------------
model AggregationCache {
  id        Int      @id @default(autoincrement())
  cacheKey  String   @unique // "summary|2026-07|WEEK 1|ALL|ALL"
  payload   String   // JSON
  computedAt DateTime @default(now())

  // PERF-OPT: index on computedAt — used by TTL cleanup queries
  // (getCached filters by computedAt > now() - TTL). Without this index,
  // every cache read does a full-table scan on AggregationCache (small
  // today but grows linearly with ingest activity).
  @@index([computedAt])
}

// ------------------------------------------------------------
//  Settings — user-configurable business standards & thresholds
//  Stored as key-value pairs. Engine reads from here, falls back
//  to hardcoded defaults in src/config/thresholds.ts if not set.
// ------------------------------------------------------------
model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   // stored as string, parsed by consumer
  category    String   // TOLERANCE | GROWTH | PRIORITY | BENCHMARK | GENERAL
  label       String   // human-readable label
  description String?
  dataType    String   // number | percent | boolean | text
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // who changed it (for audit)
}

// ------------------------------------------------------------
//  Outlet PIC (Person in Charge) — outlet-to-staff mapping
// ------------------------------------------------------------
model OutletPIC {
  id         Int      @id @default(autoincrement())
  outletCode String   @unique
  pic        String
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------
//  File Chunk — temporary storage for chunked uploads
//  Vercel serverless /tmp doesn't persist between invocations,
//  so chunks are stored in DB and reassembled on last chunk.
//  Auto-cleaned after processing (DELETE WHERE fileHash).
// ------------------------------------------------------------
model FileChunk {
  id           Int      @id @default(autoincrement())
  fileHash     String
  chunkIndex   Int
  totalChunks  Int      @default(0) // P2-11 fix: track total for validation
  data         Bytes
  createdAt    DateTime @default(now())

  @@unique([fileHash, chunkIndex])
  @@index([fileHash])
}

// ------------------------------------------------------------
//  Audit Log — request/analysis audit trail
//  ---------------------------------------------------------
//  FIX (AUDIT-DB-PUSH-1): this model was accidentally LOST from the
//  schema in an earlier force push, but the table still exists in the
//  production DB (402 rows, actively written by the currently deployed
//  app build). WITHOUT this model, `prisma db push --accept-data-loss`
//  would DROP the table and its data (verified via `prisma migrate
//  diff` before running any push). Model restored 1:1 from the live
//  table definition (timestamp(3), detail NOT NULL).
//  No app code currently reads/writes it via Prisma — kept for data
//  preservation and future re-use.
// ------------------------------------------------------------
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // e.g. ANALYSIS
  detail    String   // human-readable description of the audited action
  duration  Int?     // milliseconds (nullable for non-timed actions)
  createdAt DateTime @default(now())
}
