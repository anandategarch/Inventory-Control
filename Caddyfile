:81 {
        # FIX (DEEP-AUDIT-SECURITY-3): SSRF via XTransformPort query param.
        # Previously `query XTransformPort=*` allowed proxying to ANY port
        # (e.g. =5432 → PostgreSQL, =6379 → Redis, =22 → SSH banner).
        # Now restricted to an explicit allowlist of mini-service ports.
        #
        # Currently allowed: 3003 (websocket example — see examples/websocket/server.ts)
        # Add more `query XTransformPort=<port>` lines as new mini-services are created.
        @transform_port_query {
                query XTransformPort=3003
                # Add more allowed ports here as needed
        }

        handle @transform_port_query {
                reverse_proxy localhost:{query.XTransformPort} {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }

        handle {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                        # FIX: increase timeout for long-running imports (Excel parse + DB insert)
                        transport http {
                                read_timeout 300s
                                write_timeout 300s
                                dial_timeout 30s
                        }
                }
        }
}
