:81 {
        # PERF-FASE2-INFRA10: Enable zstd + gzip compression for all responses.
        # zstd ~30% better than gzip for text assets (HTML, JS, CSS, JSON).
        # Order matters: Caddy tries zstd first, falls back to gzip.
        encode zstd gzip

        # PERF-FASE2-INFRA10: Bypass reverse_proxy for Next.js static assets.
        # /_next/static/* files are content-hashed + cacheable forever — serving
        # them directly via Caddy's file_server skips the Node.js round-trip
        # entirely (~5-15ms saved per request). Matches the immutable
        # Cache-Control header set in next.config.ts.
        @static path /_next/static/*
        handle @static {
                header Cache-Control "public, max-age=31536000, immutable"
                root * /home/z/my-project/.next
                file_server
        }

        # FIX (DEEP-AUDIT-SECURITY-3): SSRF via XTransformPort query param.
        # Previously `query XTransformPort=*` allowed proxying to ANY port
        # (e.g. =5432 → PostgreSQL, =6379 → Redis, =22 → SSH banner).
        # Now restricted to an explicit allowlist of mini-service ports.
        #
        # Currently allowed: 3003 (websocket example — see examples/websocket/server.ts)
        # Add more `query XTransformPort=<port>` lines as new mini-services are created.
        @transform_port_query {
                query XTransformPort=3003
                # Add more allowed ports here as needed
        }

        handle @transform_port_query {
                reverse_proxy localhost:{query.XTransformPort} {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }

        handle {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                        # FIX: increase timeout for long-running imports (Excel parse + DB insert)
                        transport http {
                                read_timeout 300s
                                write_timeout 300s
                                dial_timeout 30s
                        }
                }
        }
}
